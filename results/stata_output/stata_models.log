> -1)) (100*(exp(_b[x]-1.96*_se[x])-1)) (100*(exp(_b[x]+1.96*_se[x])-1)) (2*nor
> mal(-abs(_b[x]/_se[x]))) (e(N)) (e(N_g)[1,1])
 15.     * within- and between-patient effects (aim B)
.     mixed ly xw xm c_uptake_series_min i.scan c_age_years c_weight_kg || pid:
> , reml
 16.     foreach t in xw xm {
 17.         local lab = cond("`t'" == "xw", "within-patient (aim B)", "between
> -patient")
