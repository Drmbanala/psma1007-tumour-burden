> -1)) (100*(exp(_b[`t']-1.96*_se[`t'])-1)) (100*(exp(_b[`t']+1.96*_se[`t'])-1)
> ) (2*normal(-abs(_b[`t']/_se[`t']))) (e(N)) (e(N_g)[1,1])
 19.     }
 20.     restore
 21. }
